# Copy to .env and fill in. Never commit .env.

# Postgres target — where cfde-atlas reads from.
# On onclappc02 the dev password lives in GSM (project: cdsci-infra):
#   secret: cfde-atlas-dev-db-password-onclappc02
#   PW=$(gcloud secrets versions access latest \
#     --secret=cfde-atlas-dev-db-password-onclappc02 --project=cdsci-infra)
#   DATABASE_URL=postgresql://cfde_atlas_dev:${PW}@localhost:5432/cfde_atlas_dev
DATABASE_URL=postgresql://user:password@host:5432/cfde_atlas

# icc-eval-core source. Pin to a branch or commit SHA for reproducibility.
ICC_EVAL_CORE_REF=main
ICC_EVAL_CORE_BASE_URL=https://raw.githubusercontent.com/nih-cfde/icc-eval-core

# Copy to .env and fill in. Never commit .env.

# Postgres target — where cfde-atlas reads from.
DATABASE_URL=postgresql://user:password@host:5432/cfde_atlas

# icc-eval-core source. Pin to a branch or commit SHA for reproducibility.
ICC_EVAL_CORE_REF=main
ICC_EVAL_CORE_BASE_URL=https://raw.githubusercontent.com/nih-cfde/icc-eval-core
